    <form method="POST">
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="<?= h($_POST['email']??'') ?>" placeholder="email@azienda.it" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required>
